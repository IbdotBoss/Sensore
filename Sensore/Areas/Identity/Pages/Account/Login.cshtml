@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<!-- Custom Styles for Login Page to match Dark Theme -->
<style>
    body {
        background-color: #151521;
        color: #fff;
    }

    .card-login {
        background-color: #1e1e2d;
        border: 1px solid #2b2b40;
        border-radius: 12px;
    }

    .form-control {
        background-color: #151521;
        border: 1px solid #2b2b40;
        color: white;
    }

        .form-control:focus {
            background-color: #151521;
            border-color: #3699ff;
            color: white;
            box-shadow: none;
        }

    .text-muted-custom {
        color: #92929f;
    }

    a {
        color: #3699ff;
        text-decoration: none;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="text-center mb-4">
                <h1 class="fw-bold">Sensore</h1>
                <p class="text-muted-custom">Please sign in to continue</p>
            </div>

            <div class="card card-login shadow-lg p-4">
                <section>
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="text-muted">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="text-muted">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="checkbox mb-3">
                            <label asp-for="Input.RememberMe" class="form-label text-muted-custom">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>

                        <div>
                            <button id="login-submit" type="submit" class="btn btn-primary w-100 py-2 fw-bold">Log in</button>
                        </div>

                        <div class="text-center mt-3">
                            <p>
                                <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                            </p>
                            <!-- Note: Register link removed per previous step -->
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}