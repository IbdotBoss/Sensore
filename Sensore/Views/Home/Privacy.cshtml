@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    body {
        background-color: #0f0f1e;
        color: #e0e0e0;
    }

    .privacy-container {
        max-width: 900px;
        margin: 3rem auto;
        background-color: #1e1e2d;
        border-radius: 16px;
        padding: 3rem;
    }

    .privacy-title {
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .privacy-section {
        margin-bottom: 2rem;
    }

    .privacy-section h3 {
        color: #667eea;
        margin-bottom: 1rem;
    }

    .privacy-section p {
        color: #b0b0c0;
        line-height: 1.8;
    }
</style>

<div class="privacy-container">
    <h1 class="privacy-title">Privacy Policy</h1>

    <div class="privacy-section">
        <h3>Information We Collect</h3>
        <p>
            Sensore collects health-related data including pressure sensor readings, user account information, 
            and communication between patients and healthcare providers. All data is encrypted and stored securely.
        </p>
    </div>

    <div class="privacy-section">
        <h3>How We Use Your Information</h3>
        <p>
            Your data is used exclusively for healthcare monitoring and analysis purposes. We generate reports, 
            track trends, and provide alerts to help prevent pressure-related health issues.
        </p>
    </div>

    <div class="privacy-section">
        <h3>Data Security</h3>
        <p>
            We implement industry-standard security measures including encryption, secure authentication, 
            and role-based access control to protect your sensitive health information.
        </p>
    </div>

    <div class="privacy-section">
        <h3>HIPAA Compliance</h3>
        <p>
            Sensore is designed to comply with HIPAA regulations for protecting patient health information. 
            Your data is only accessible to authorized healthcare providers assigned to your care.
        </p>
    </div>

    <div class="privacy-section">
        <h3>Your Rights</h3>
        <p>
            You have the right to access, modify, or delete your personal health information at any time. 
            Contact your healthcare provider or system administrator for assistance.
        </p>
    </div>

    <div class="privacy-section">
        <h3>Contact Us</h3>
        <p>
            If you have questions about this privacy policy or your data, please contact your healthcare provider 
            or system administrator.
        </p>
    </div>
</div>