@* 
    Patient Dashboard Page
  Main view for patients to see their pressure data and communicate with care team.
    Shows heatmap, KPIs, trend chart, daily report, and comment history.
*@

@model Sensore.Models.PatientDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    var historyFrames = Model.History ?? new List<Sensore.Models.PressureFrame>();
    // Prepare chart data as JSON for JavaScript consumption
    var chartData = historyFrames.Select((h, index) => new { 
        ts = h.Timestamp.ToString("o"),
        v = h.PeakPressureIndex 
    });
}

@* Page Styling - Dark theme matching Sensore branding *@
<style>
    body { background-color: #0f0f1e; color: #e0e0e0; }
    .dark-container { background-color: #1e1e2d; border-radius: 12px; padding: 2rem; margin-bottom: 1.5rem; }
    .kpi-card { background-color: #1e1e2d; border-radius: 12px; padding: 1.5rem; margin-bottom: 1rem; text-align: center; }
    .kpi-value { font-size: 2.5rem; font-weight: 700; margin: 0.5rem 0; }
    .kpi-label { font-size: 0.85rem; color: #8e8ea0; text-transform: uppercase; letter-spacing: 0.5px; }
    .risk-score { color: #ffab40; }
    .peak-pressure { color: #ff5252; }
    .contact-area { color: #69f0ae; }
    .zone-card { background-color: #2a2a3e; border: 1px solid #3a3a4e; border-radius: 8px; padding: 1.25rem; text-align: center; }
    .zone-label { font-size: 0.75rem; color: #8e8ea0; text-transform: uppercase; margin-bottom: 0.5rem; }
    .zone-value { font-size: 1.5rem; font-weight: 700; color: #ffffff; }
    .feedback-section { background-color: #1e1e2d; border-radius: 12px; padding: 2rem; }
    .feedback-textarea { background-color: #2a2a3e; border: 1px solid #3a3a4e; border-radius: 12px; padding: 1.5rem; color: #e0e0e0; resize: none; width: 100%; min-height: 150px; font-size: 1rem; }
    .feedback-textarea:focus { outline: none; border-color: #4285f4; box-shadow: 0 0 0 3px rgba(66, 133, 244, 0.1); }
  .feedback-textarea::placeholder { color: #6c6c80; }
    .btn-submit-comment { background-color: #4285f4; color: white; border: none; padding: 1rem 3rem; border-radius: 12px; font-weight: 600; font-size: 1.1rem; width: 100%; transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s; }
    .btn-submit-comment:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(66, 133, 244, 0.4); background-color: #3b78e7; color: white; }
    .btn-reports { background-color: transparent; border: 2px solid #4285f4; color: #4285f4; padding: 0.5rem 1.5rem; border-radius: 8px; font-weight: 600; transition: all 0.2s; }
    .btn-reports:hover { background-color: #4285f4; color: white; border-color: #4285f4; }
    .time-range-btn { background-color: #2a2a3e; border: 1px solid #3a3a4e; color: #a0a0b0; padding: 0.5rem 1rem; font-size: 0.85rem; transition: all 0.2s; }
    .time-range-btn:hover, .time-range-btn.active { background-color: #4285f4; border-color: #4285f4; color: white; }
    .report-container { background-color: #1e1e2d; border-radius: 12px; padding: 2rem; margin-bottom: 1.5rem; }
    .report-summary-card { background-color: #2a2a3e; border-radius: 8px; padding: 1.5rem; text-align: center; }
    .report-summary-label { font-size: 0.85rem; color: #8e8ea0; margin-bottom: 0.5rem; }
    .report-summary-value { font-size: 2rem, font-weight: 700; }
    .clinician-note { background-color: #2a2a3e; border-left: 4px solid #4285f4; padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem; }
    .clinician-name { color: #4285f4; font-weight: 600; margin-bottom: 0.5rem; }
    .note-date { font-size: 0.85rem; color: #8e8ea0; }
    .chat-container { max-height: 500px; overflow-y: auto; padding: 1rem; margin-bottom: 1rem; }
    .chat-message { margin-bottom: 1.5rem; display: flex; }
    .chat-message.patient-message { justify-content: flex-end; }
    .chat-message.clinician-message { justify-content: flex-start; }
    .chat-bubble { max-width: 70%; padding: 1rem 1.25rem; border-radius: 16px; }
    .chat-patient { background-color: #4285f4; color: white; border-bottom-right-radius: 4px; }
    .chat-clinician { background-color: #2a2a3e; color: #e0e0e0; border-bottom-left-radius: 4px; }
    .chat-meta { font-size: 0.75rem; opacity: 0.8; margin-top: 0.5rem; }
    .chart-container { position: relative; height: 300px; width: 100%; }
    .btn-print { background-color: #28a745; color: white; border: none; padding: 0.75rem 2rem; border-radius: 8px; font-weight: 500; }
.btn-print:hover { background-color: #218838; color: white; }
    .btn-simulate-alert { background-color: #dc3545; color: white; border: none; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-simulate-alert:hover { background-color: #c82333; }

@* Alert Modal Styles *@
    .alert-modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.7); z-index: 9999; justify-content: center; align-items: center; }
    .alert-modal-overlay.show { display: flex; }
    .alert-modal { background-color: #1e1e2d; border-radius: 16px; padding: 3rem; max-width: 500px; width: 90%; text-align: center; border: 2px solid #dc3545; box-shadow: 0 20px 60px rgba(220, 53, 69, 0.3); animation: modalSlideIn 0.3s ease-out; }
    @@keyframes modalSlideIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .alert-icon-circle { width: 80px; height: 80px; border-radius: 50%; background-color: rgba(220, 53, 69, 0.2); display: flex; justify-content: center; align-items: center; margin: 0 auto 1.5rem; }
    .alert-icon { font-size: 2.5rem; color: #dc3545; }
    .alert-modal h2 { color: #ffffff; font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; }
    .alert-modal p { color: #a0a0b0; font-size: 1.1rem; line-height: 1.6; margin-bottom: 2rem; }
    .btn-acknowledge { background-color: #4285f4; color: white; border: none; padding: 1rem 3rem; border-radius: 12px; font-weight: 600; font-size: 1.1rem; width: 100%; cursor: pointer; transition: all 0.2s; }
    .btn-acknowledge:hover { background-color: #3b78e7; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(66, 133, 244, 0.4); }

    @* Print Styles *@
    @@media print {
body { background-color: white !important; color: black !important; }
     .dark-container, .report-container { background-color: white !important; border: 1px solid #ddd; }
        .btn-reports, .btn-print, form, .feedback-section, .btn-simulate-alert { display: none !important; }
   .report-summary-card { background-color: #f5f5f5 !important; border: 1px solid #ddd; }
   .text-white, .text-muted { color: black !important; }
        .report-summary-value { color: black !important; }
    }
</style>

@* Alert Modal - Shown when high pressure detected *@
<div class="alert-modal-overlay" id="alertModal">
    <div class="alert-modal">
<div class="alert-icon-circle">
            <i class="bi bi-exclamation-triangle-fill alert-icon"></i>
        </div>
        <h2>High Pressure Detected!</h2>
 <p>Please adjust your position to relieve pressure. This event has been flagged for your clinician.</p>
        <button class="btn-acknowledge" onclick="closeAlertModal()">Acknowledge</button>
    </div>
</div>

<div class="container-fluid mt-4">
    @* Page Header with navigation and action buttons *@
 <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="javascript:history.back()" class="text-muted text-decoration-none me-3">
<i class="bi bi-arrow-left"></i> Back
            </a>
  <h2 class="text-white d-inline-block mb-0">@Model.UserName</h2>
        </div>
   <div>
 <button onclick="showReportView()" class="btn btn-reports me-2">
            <i class="bi bi-file-earmark-text"></i> Reports
       </button>
    <button class="btn-simulate-alert" onclick="showAlertModal()">
                <i class="bi bi-exclamation-triangle"></i> Simulate Alert
    </button>
        </div>
    </div>

    @* Main Dashboard View *@
    <div id="dashboardView">
        @if (Model.LatestFrame == null)
 {
            <div class="alert alert-info">No sensor data available yet.</div>
        }
    else
     {
            <div class="row">
                @* Left Column - Heatmap and Zonal Analysis *@
    <div class="col-lg-8">
        @* Live Pressure Heatmap (32x32 grid) *@
     <div class="dark-container">
        <h5 class="text-white mb-3">Live Pressure Map</h5>
     <canvas id="heatmapCanvas" width="500" height="500" style="max-width: 100%; border: 1px solid #2a2a3e; background-color: #0f0f1e; border-radius: 8px;"></canvas>
   @* Color scale legend *@
     <div class="mt-3">
            <div style="height: 8px; background: linear-gradient(90deg, blue, cyan, yellow, red); border-radius: 4px;"></div>
   <div class="d-flex justify-content-between text-muted small mt-1">
       <span>Low (0 mmHg)</span>
               <span>High (255 mmHg)</span>
         </div>
        </div>
      </div>

     @* Zonal Contact Area - 3x3 grid showing pressure by body region *@
         <div class="dark-container">
    <h5 class="text-white mb-3">Zonal Contact Area</h5>
  <div class="row g-3">
              @{ 
   var zones = new[] {
      new { Name = "Upper Lateral", Val = 45 }, new { Name = "Upper Medial", Val = 52 }, new { Name = "Upper Lateral", Val = 48 },
 new { Name = "Mid Lateral", Val = 68 }, new { Name = "Mid Center", Val = 89 }, new { Name = "Mid Lateral", Val = 71 },
        new { Name = "Lower Lateral", Val = 95 }, new { Name = "Lower Medial", Val = 108 }, new { Name = "Lower Lateral", Val = 92 }
           };
             }
         @foreach (var zone in zones)
      {
       <div class="col-4">
         <div class="zone-card">
           <div class="zone-label">@zone.Name</div>
            <div class="zone-value">@zone.Val <small class="text-muted">mmHg</small></div>
           </div>
            </div>
      }
      </div>
     </div>
    </div>

     @* Right Column - KPIs and Feedback Form *@
     <div class="col-lg-4">
         @* Risk Score KPI *@
           <div class="kpi-card">
         <div class="kpi-label">Risk Score</div>
             <div class="kpi-value risk-score">
  @{ var riskScore = Model.LatestFrame != null ? Math.Min(Math.Round((double)Model.LatestFrame.PeakPressureIndex / 25.5, 1), 10.0) : 0; }
    @riskScore.ToString("F1")<span class="fs-4 text-muted">/10</span>
         </div>
 </div>

            @* Peak Pressure KPI *@
  <div class="kpi-card">
        <div class="kpi-label">Peak Pressure</div>
      <div class="kpi-value peak-pressure">@Model.LatestFrame.PeakPressureIndex <span class="fs-4 text-muted">mmHg</span></div>
               </div>

     @* Contact Area KPI *@
      <div class="kpi-card">
         <div class="kpi-label">Total Contact Area</div>
          <div class="kpi-value contact-area">@Model.LatestFrame.ContactAreaPercent.ToString("F0")<span class="fs-4 text-muted">%</span></div>
          </div>

        @* Patient Feedback Form *@
           <div class="feedback-section">
     <h5 class="text-white mb-3"><i class="bi bi-send"></i> Send Feedback</h5>
<form asp-action="AddComment" method="post">
                <textarea name="commentText" class="feedback-textarea mb-3" placeholder="Write a comment for your clinician..." required></textarea>
  <button type="submit" class="btn btn-submit-comment">Submit Comment</button>
             </form>
          </div>
  </div>
         </div>

   @* Pressure Trend Chart with Time Filter *@
   <div class="dark-container mt-4">
<div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="text-white mb-0">Peak Pressure Over Time</h5>
   @* Time range filter buttons *@
     <div class="btn-group">
           <button class="time-range-btn active" onclick="filterChart(1)">1h</button>
             <button class="time-range-btn" onclick="filterChart(6)">6h</button>
          <button class="time-range-btn" onclick="filterChart(24)">24h</button>
   <button class="time-range-btn" onclick="filterChart(0)">All</button>
         </div>
              </div>
  <div class="chart-container"><canvas id="pressureChart"></canvas></div>
  @if (Model.History == null || !Model.History.Any())
    {
            <div class="text-center text-muted py-4"><i class="bi bi-info-circle"></i> No pressure history data available</div>
     }
            </div>

            @* Communication History - Chat-style display *@
     @if (Model.RecentComments != null && Model.RecentComments.Any())
        {
      <div class="dark-container">
  <h5 class="text-white mb-3"><i class="bi bi-chat-dots"></i> Communication History</h5>
                <div class="chat-container">
  @foreach (var comment in Model.RecentComments)
     {
        @* Patient's comment *@
          <div class="chat-message patient-message">
    <div class="chat-bubble chat-patient">
  <div>@comment.CommentText</div>
           <div class="chat-meta">You - @comment.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")</div>
 </div>
  </div>
        @* Clinician replies *@
      if (comment.Replies != null && comment.Replies.Any())
    {
         foreach (var reply in comment.Replies.OrderBy(r => r.CreatedAt))
      {
     <div class="chat-message clinician-message">
      <div class="chat-bubble chat-clinician">
       <div>@reply.CommentText</div>
 <div class="chat-meta">
       <span class="badge bg-primary">Clinician</span>
          @(reply.AuthorUser?.FullName ?? "Clinician") - @reply.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
</div>
       </div>
            </div>
         }
      }
        }
 </div>
           </div>
            }
        }
    </div>

    @* Report View (hidden by default) *@
    <div id="reportView" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-4">
       <h2 class="text-white">My Weekly Report</h2>
  <div>
            <button class="btn btn-print me-2" onclick="printReport()"><i class="bi bi-printer"></i> Print Report</button>
           <button onclick="showDashboardView()" class="btn btn-outline-light"><i class="bi bi-arrow-left"></i> Back to Dashboard</button>
   </div>
        </div>

        @* Report Summary Cards *@
 <div class="report-container">
            <h5 class="text-white mb-4">Summary</h5>
        <div class="row g-3">
              <div class="col-md-3">
          <div class="report-summary-card">
       <div class="report-summary-label">Avg. Peak Pressure</div>
      <div class="report-summary-value text-danger">
          @{ var avgPressure = Model.History != null && Model.History.Any() ? Model.History.Average(h => h.PeakPressureIndex) : 0; }
        @avgPressure.ToString("F0") <small>mmHg</small>
      </div>
              </div>
     </div>
       <div class="col-md-3">
    <div class="report-summary-card">
   <div class="report-summary-label">Max Pressure</div>
         <div class="report-summary-value text-warning">@(Model.History != null && Model.History.Any() ? Model.History.Max(h => h.PeakPressureIndex) : 0) <small>mmHg</small></div>
      </div>
      </div>
    <div class="col-md-3">
             <div class="report-summary-card">
           <div class="report-summary-label">Avg. Contact Area</div>
   <div class="report-summary-value text-success">
     @{ var avgContact = Model.History != null && Model.History.Any() ? Model.History.Average(h => h.ContactAreaPercent) : 0; }
     @avgContact.ToString("F1")%
        </div>
              </div>
            </div>
          <div class="col-md-3">
       <div class="report-summary-card">
        <div class="report-summary-label">Total Alerts</div>
       <div class="report-summary-value text-info">@(Model.History != null ? Model.History.Count(h => h.IsAlertFlagged) : 0)</div>
 </div>
  </div>
            </div>
        </div>

   @* Weekly Trend Chart *@
        <div class="report-container">
    <h5 class="text-white mb-4">Weekly Trend</h5>
   <div class="chart-container"><canvas id="weeklyComparisonChart"></canvas></div>
</div>

        @* Clinician Notes Section *@
        <div class="report-container">
  <h5 class="text-white mb-4">Clinician Notes</h5>
 @if (Model.RecentComments != null && Model.RecentComments.Any())
  {
          foreach (var comment in Model.RecentComments)
    {
            if (comment.Replies != null && comment.Replies.Any())
        {
         foreach (var reply in comment.Replies.OrderByDescending(r => r.CreatedAt))
            {
       <div class="clinician-note">
  <div class="clinician-name"><i class="bi bi-person-badge"></i> @(reply.AuthorUser?.FullName ?? "Dr. Clinician")</div>
       <p class="mb-2">@reply.CommentText</p>
          <div class="note-date">@reply.CreatedAt.ToString("MMM dd, yyyy")</div>
                   </div>
         }
         }
    }
  }
            else
            {
          <div class="clinician-note">
   <div class="clinician-name"><i class="bi bi-person-badge"></i> Your Care Team</div>
           <p class="mb-2">No clinician notes yet. Your care team will post updates here as they review your progress.</p>
           <div class="note-date">@DateTime.Now.ToString("MMM dd, yyyy")</div>
     </div>
            }
        </div>

  <div class="report-container">
        <p class="text-muted mb-0">Report generated on @DateTime.Now.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
        </div>
    </div>
</div>

@* Data passed to JavaScript for chart rendering *@
<script id="heatmapData" type="application/json">@Html.Raw(Model.LatestFrame?.PressureDataJson ?? "[]")</script>
<script id="historyData" type="application/json">@Html.Raw(Json.Serialize(chartData))</script>

@* External libraries *@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<script>
    // Chart instances (stored globally for destruction/recreation)
    let pressureChart = null;
    let weeklyChart = null;
    let allHistoryData = [];

    // ========================================================================
    // ALERT MODAL FUNCTIONS
    // ========================================================================

    // Show the high pressure alert modal
    function showAlertModal() {
        document.getElementById('alertModal').classList.add('show');
        document.body.style.overflow = 'hidden'; // Prevent background scroll
    }

    // Close the alert modal
    function closeAlertModal() {
 document.getElementById('alertModal').classList.remove('show');
 document.body.style.overflow = 'auto';
    }

    // Close modal when clicking outside
    document.getElementById('alertModal').addEventListener('click', function(e) {
        if (e.target === this) closeAlertModal();
    });

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeAlertModal();
    });

    // ========================================================================
    // VIEW SWITCHING FUNCTIONS
    // ========================================================================

    // Switch to report view
    function showReportView() {
document.getElementById('dashboardView').style.display = 'none';
 document.getElementById('reportView').style.display = 'block';
 setTimeout(initWeeklyChart, 100); // Initialize chart after view is visible
    }

    // Switch back to dashboard view
    function showDashboardView() {
     document.getElementById('dashboardView').style.display = 'block';
   document.getElementById('reportView').style.display = 'none';
    }

    // Print the report
    function printReport() { 
        window.print(); 
    }

    // ========================================================================
    // PAGE INITIALIZATION
// ========================================================================

    document.addEventListener("DOMContentLoaded", function () {
        // Initialize the 32x32 heatmap canvas
        const canvas = document.getElementById('heatmapCanvas');
  if (canvas) {
         const ctx = canvas.getContext('2d');
            let rawData = [];
    try { 
              rawData = JSON.parse(document.getElementById('heatmapData').textContent); 
    } catch (e) { 
  console.error('Error parsing heatmap data:', e);
        }
            
  const size = 32;
      const cellSize = canvas.width / size;
       
    // Draw each cell of the pressure matrix
            if (rawData && rawData.length > 0) {
          for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
      if (rawData[r] && typeof rawData[r][c] !== 'undefined') {
                ctx.fillStyle = getColor(rawData[r][c]);
            ctx.fillRect(c * cellSize, r * cellSize, cellSize, cellSize);
      }
       }
        }
  }
        }

      // Load history data for the trend chart
    try { 
        allHistoryData = JSON.parse(document.getElementById('historyData').textContent); 
        } catch (e) { 
      allHistoryData = []; 
        }
        
        // Initialize chart with 1h filter (default)
        filterChart(1);
    });

    // ========================================================================
    // PRESSURE TREND CHART
    // ========================================================================

    // Initialize or update the pressure chart with filtered data
    function initPressureChart(data, hours) {
        const chartCtx = document.getElementById('pressureChart');
   if (!chartCtx) return;
        
        // Destroy existing chart before creating new one
      if (pressureChart) pressureChart.destroy();

      if (data && data.length > 0) {
        // Downsample data if too many points for performance
    let displayData = data;
          if (data.length > 100) {
                const step = Math.ceil(data.length / 100);
      displayData = data.filter((_, i) => i % step === 0);
    }

      // Format time labels for x-axis
            const labels = displayData.map(d => {
 const date = new Date(d.ts);
    if (hours <= 1) {
           // For 1h: show HH:MM:SS
 return date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
} else if (hours <= 24) {
     // For 6h/24h: show HH:MM
           return date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
 } else {
      // For All: show date + time
          return date.toLocaleDateString('en-GB', { month: 'short', day: 'numeric' }) + ' ' +
               date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
                }
    });

 // Create Chart.js line chart
            pressureChart = new Chart(chartCtx, {
                type: 'line',
                data: {
              labels: labels,
        datasets: [{
      label: 'Peak Pressure (mmHg)',
          data: displayData.map(d => d.v),
  borderColor: '#4285f4',
          backgroundColor: 'rgba(66, 133, 244, 0.1)',
      tension: 0.3,
           fill: true,
         pointRadius: displayData.length > 50 ? 0 : 3
          }]
                },
    options: {
         responsive: true,
          maintainAspectRatio: false,
           plugins: {
         legend: { labels: { color: '#e0e0e0' } },
             title: {
     display: true,
    text: hours === 0 ? `Showing all ${data.length} readings` : `Showing last ${hours}h (${data.length} readings)`,
           color: '#8e8ea0',
   font: { size: 12 }
            }
     },
           scales: {
           y: { 
       beginAtZero: true, 
        suggestedMax: 200, 
      ticks: { color: '#a0a0b0' }, 
              grid: { color: '#2a2a3e' } 
      },
              x: { 
   ticks: { 
    color: '#a0a0b0', 
    maxRotation: 45, 
      maxTicksLimit: hours === 1 ? 12 : hours === 6 ? 7 : hours === 24 ? 8 : 10 
        }, 
       grid: { color: '#2a2a3e' } 
             }
          }
     }
 });
    }
    }

    // Filter chart data by time range (hours)
    // Uses the LATEST timestamp in data as reference point (not current time)
    function filterChart(hours) {
   // Update active button state
   document.querySelectorAll('.time-range-btn').forEach((btn, index) => {
  btn.classList.remove('active');
          const btnHours = [1, 6, 24, 0][index];
         if (btnHours === hours) btn.classList.add('active');
        });

        // Handle empty data
    if (allHistoryData.length === 0) {
initPressureChart([], hours);
 return;
        }

        // Show all data if hours is 0
        if (hours === 0) {
            initPressureChart(allHistoryData, hours);
            return;
        }

        // Find the latest timestamp in the data (not current time!)
        // This makes the filter work with historical/seeded data
  const timestamps = allHistoryData.map(d => new Date(d.ts).getTime());
        const latestTime = Math.max(...timestamps);
        const cutoffTime = latestTime - (hours * 60 * 60 * 1000);

        // Filter data within the time range
        const filtered = allHistoryData.filter(d => new Date(d.ts).getTime() >= cutoffTime);

        // Show filtered data (or all if nothing matches)
      initPressureChart(filtered.length > 0 ? filtered : allHistoryData, hours);
}

    // ========================================================================
    // WEEKLY COMPARISON CHART
    // ========================================================================

    function initWeeklyChart() {
        const weeklyCtx = document.getElementById('weeklyComparisonChart');
        if (!weeklyCtx || weeklyChart) return;

        // Sample data for weekly comparison (would be calculated from real data)
        weeklyChart = new Chart(weeklyCtx, {
            type: 'bar',
         data: {
  labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    datasets: [{
     label: 'Avg Peak Pressure (mmHg)',
             data: [95, 102, 88, 110, 98, 92, 85],
      backgroundColor: '#4285f4',
     borderRadius: 8
                }]
   },
   options: {
      responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { labels: { color: '#e0e0e0' } } },
       scales: {
         y: { beginAtZero: true, ticks: { color: '#a0a0b0' }, grid: { color: '#2a2a3e' } },
      x: { ticks: { color: '#a0a0b0' }, grid: { display: false } }
            }
      }
    });
  }

    // ========================================================================
    // HEATMAP COLOR FUNCTION
    // ========================================================================

    // Convert pressure value (0-255) to color gradient (blue->cyan->yellow->red)
    function getColor(value) {
        if (value < 10) return "#0f0f1e";  // Background (no pressure)
        if (value < 85) return "rgb(0, " + Math.floor((value / 85) * 255) + ", 255)";  // Blue to Cyan
        if (value < 170) return "rgb(0, 255, " + (255 - Math.floor(((value - 85) / 85) * 255)) + ")";  // Cyan to Green/Yellow
        return "rgb(255, " + (255 - Math.floor(((value - 170) / 85) * 255)) + ", 0)";  // Yellow to Red
    }
</script>