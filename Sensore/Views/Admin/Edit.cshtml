@model Sensore.Models.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-white">Edit User</h2>
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-lg" style="background-color: #1e1e2d;">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CurrentRole" />
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label text-white"></label>
                        <input asp-for="FullName" class="form-control" style="background-color: #2a2a3e; color: #e0e0e0; border-color: #3a3a4e;" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label text-white"></label>
                        <input asp-for="Email" class="form-control" style="background-color: #2a2a3e; color: #e0e0e0; border-color: #3a3a4e;" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-white">Current Role</label>
                        <input type="text" class="form-control" value="@Model.CurrentRole" readonly style="background-color: #2a2a3e; color: #8e8ea0; border-color: #3a3a4e;" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SelectedRole" class="form-label text-white"></label>
                        <select asp-for="SelectedRole" asp-items="Model.RoleList" class="form-select" style="background-color: #2a2a3e; color: #e0e0e0; border-color: #3a3a4e;">
                            <option value="">-- Select Role --</option>
                        </select>
                        <span asp-validation-for="SelectedRole" class="text-danger"></span>
                    </div>
                </div>

                <hr style="border-color: #3a3a4e;" class="my-4" />

                <h5 class="text-white mb-3">Change Password (Optional)</h5>
                <p class="text-muted small">Leave blank to keep the current password</p>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="NewPassword" class="form-label text-white"></label>
                        <input asp-for="NewPassword" class="form-control" style="background-color: #2a2a3e; color: #e0e0e0; border-color: #3a3a4e;" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmNewPassword" class="form-label text-white"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control" style="background-color: #2a2a3e; color: #e0e0e0; border-color: #3a3a4e;" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-circle"></i> Update User
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}