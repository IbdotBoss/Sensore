@* 
Patient Linking Page
 Allows admins to assign patients to clinicians.
  Shows available patients on the left and assigned patients on the right.
*@

@model Sensore.Models.PatientLinkingViewModel
@{
    ViewData["Title"] = "Patient Linking";
}

<div class="container mt-4">
    <h2>Patient-Clinician Manager</h2>
    <hr />

  @* Clinician Selection Card *@
    <div class="card mb-4" style="background-color: #1e1e2d; border-color: #2a2a3e;">
        <div class="card-body">
 <form method="get" class="row g-3 align-items-center">
       <div class="col-auto">
      <label class="col-form-label fw-bold">Select Clinician:</label>
   </div>
        <div class="col-auto">
         @* Clinician Dropdown - Auto-submits on change *@
             <select name="clinicianId" asp-items="Model.ClinicianList" class="form-select" onchange="this.form.submit()">
    <option value="">-- Choose a Clinician --</option>
           </select>
     </div>
   </form>
        </div>
    </div>

    @* Patient Assignment Panel - Only shown when a clinician is selected *@
    @if (!string.IsNullOrEmpty(Model.SelectedClinicianId))
    {
        <div class="row">
            @* Left Panel: Available (Unassigned) Patients *@
 <div class="col-md-6">
   <div class="card" style="background-color: #1e1e2d; border-color: #4caf50;">
       <div class="card-header text-white" style="background-color: #2a2a3e;">
        Available Patients
       </div>
   <ul class="list-group list-group-flush">
            @* Empty State Message *@
    @if (Model.AvailablePatients.Count == 0)
        {
 <li class="list-group-item text-muted">No unassigned patients found.</li>
    }
   @* List of Available Patients with Link Button *@
     @foreach (var patient in Model.AvailablePatients)
            {
   <li class="list-group-item d-flex justify-content-between align-items-center">
    <div>
        <strong>@patient.FullName</strong> <br />
 <small class="text-muted">@patient.Email</small>
     </div>
          @* Form to Add Patient Assignment *@
         <form asp-action="ToggleLink" method="post">
  <input type="hidden" name="clinicianId" value="@Model.SelectedClinicianId" />
 <input type="hidden" name="patientId" value="@patient.Id" />
     <input type="hidden" name="actionType" value="Add" />
   <button type="submit" class="btn btn-sm btn-success">Link &rarr;</button>
        </form>
   </li>
         }
        </ul>
         </div>
     </div>

            @* Right Panel: Assigned Patients *@
     <div class="col-md-6">
   <div class="card border-primary">
    <div class="card-header bg-primary text-white">Assigned Patients</div>
      <ul class="list-group list-group-flush">
          @* Empty State Message *@
            @if (Model.AssignedPatients.Count == 0)
      {
  <li class="list-group-item text-muted">No patients assigned yet.</li>
        }
   @* List of Assigned Patients with Unlink Button *@
    @foreach (var patient in Model.AssignedPatients)
  {
   <li class="list-group-item d-flex justify-content-between align-items-center">
 <div>
        <strong>@patient.FullName</strong> <br />
     <small class="text-muted">@patient.Email</small>
      </div>
       @* Form to Remove Patient Assignment *@
     <form asp-action="ToggleLink" method="post">
<input type="hidden" name="clinicianId" value="@Model.SelectedClinicianId" />
    <input type="hidden" name="patientId" value="@patient.Id" />
  <input type="hidden" name="actionType" value="Remove" />
         <button type="submit" class="btn btn-sm btn-outline-danger">&larr; Unlink</button>
 </form>
            </li>
         }
</ul>
      </div>
            </div>
        </div>
    }
</div>