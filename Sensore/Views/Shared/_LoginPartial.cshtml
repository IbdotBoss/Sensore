@* 
    Login Partial View
    Displays user greeting and logout button when authenticated.
    Shows login link when not authenticated.
    Included in the navbar of the main layout.
*@

@using Microsoft.AspNetCore.Identity
@using Sensore.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @* Authenticated User View *@
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var displayName = currentUser?.FullName ?? currentUser?.Email ?? "User";

    @* User Greeting Link *@
        <li class="nav-item">
      <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
       <i class="bi bi-person-circle"></i> Hello @displayName!
            </a>
        </li>
      @* Logout Button *@
 <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
      <button type="submit" class="nav-link btn btn-link text-white">Logout</button>
            </form>
      </li>
    }
    else
    {
        @* Login Link for Unauthenticated Users *@
 <li class="nav-item">
        <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>

@* Partial View Styles *@
<style>
    .navbar-nav .nav-link {
     color: #e0e0e0 !important;
        transition: color 0.2s;
 font-weight: 500;
    }

    .navbar-nav .nav-link:hover {
        color: #ffffff !important;
    }

    .btn-link {
        text-decoration: none;
        padding: 0;
    }

    .btn-link:hover {
        text-decoration: underline;
    }

 .nav-item form {
        margin: 0;
    }

    .bi-person-circle {
        font-size: 1.2rem;
        margin-right: 0.25rem;
    }
</style>