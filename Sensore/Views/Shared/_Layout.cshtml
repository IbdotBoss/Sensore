<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sensore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sensore.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        /* Global Dark Theme */
        body {
            background-color: #0f0f1e;
            color: #e0e0e0;
            min-height: 100vh;
        }

        /* Navbar Styling */
        .navbar {
            background-color: #1e1e2d !important;
            border-bottom: 1px solid #2a2a3e;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .navbar-brand {
            color: #ffffff !important;
            font-weight: 700;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .navbar-brand:hover {
            color: #667eea !important;
        }

        .navbar-toggler {
            border-color: rgba(255, 255, 255, 0.1);
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.75%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* Main Content Area */
        main {
            min-height: calc(100vh - 140px);
        }

        /* Footer */
        .footer {
            background-color: #1e1e2d;
            border-top: 1px solid #2a2a3e;
            color: #8e8ea0;
            padding: 1.5rem 0;
        }

        .footer a {
            color: #667eea;
            text-decoration: none;
        }

        .footer a:hover {
            color: #764ba2;
            text-decoration: underline;
        }

        /* Card Improvements */
        .card {
            background-color: #1e1e2d;
            border: 1px solid #2a2a3e;
            color: #e0e0e0;
        }

        .card-header {
            background-color: #2a2a3e;
            border-bottom: 1px solid #3a3a4e;
            color: #ffffff;
        }

        /* Form Controls */
        .form-control,
        .form-select {
            background-color: #2a2a3e;
            border: 1px solid #3a3a4e;
            color: #e0e0e0;
        }

        .form-control:focus,
        .form-select:focus {
            background-color: #2a2a3e;
            border-color: #667eea;
            color: #e0e0e0;
            box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
        }

        .form-control::placeholder {
            color: #6c6c80;
        }

        /* Labels */
        .form-label {
            color: #b0b0c0;
            font-weight: 500;
        }

        /* Buttons */
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #5a6fcf 0%, #654091 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background-color: #3a3a4e;
            border: none;
            color: #e0e0e0;
        }

        .btn-secondary:hover {
            background-color: #4a4a5e;
            color: #ffffff;
        }

        /* Tables */
        .table {
            color: #e0e0e0;
        }

        .table thead th {
            border-color: #2a2a3e;
            background-color: #2a2a3e;
        }

        .table tbody td {
            border-color: #2a2a3e;
        }

        .table-striped > tbody > tr:nth-of-type(odd) > * {
            color: #e0e0e0;
            background-color: rgba(42, 42, 62, 0.3);
        }

        .table-hover > tbody > tr:hover > * {
            background-color: rgba(102, 126, 234, 0.1);
        }

        /* Links */
        a {
            color: #667eea;
        }

        a:hover {
            color: #764ba2;
        }

        /* Alerts */
        .alert {
            border: none;
        }

        .alert-info {
            background-color: rgba(102, 126, 234, 0.15);
            color: #a0b0ff;
        }

        .alert-success {
            background-color: rgba(105, 240, 174, 0.15);
            color: #69f0ae;
        }

        .alert-warning {
            background-color: rgba(255, 171, 64, 0.15);
            color: #ffab40;
        }

        .alert-danger {
            background-color: rgba(255, 82, 82, 0.15);
            color: #ff5252;
        }

        /* Text Colors */
        .text-muted {
            color: #8e8ea0 !important;
        }

        .text-white {
            color: #ffffff !important;
        }

        /* Sensore Logo Icon */
        .navbar-brand::before {
            content: "📊";
            font-size: 1.5rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Sensore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    
                    <!-- Login Partial -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </main>
    </div>

    <footer class="footer text-muted mt-5">
        <div class="container">
            &copy; 2025 - Sensore - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
